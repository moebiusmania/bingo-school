{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite --host",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "check": "deno check src vite.config.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "types": ["vite/client"]
  },
  "fmt": {
    "singleQuote": true
  },
  "imports": {
    "@fontsource/creepster": "npm:@fontsource/creepster@^5.3.0",
    "@fontsource/fredoka": "npm:@fontsource/fredoka@^5.3.0",
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.6",
    "preact": "npm:preact@^11.0.1",
    "vite": "npm:vite@^8.3.4"
  }
}
